{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$key": {
        ".read": "$key.matches(/^[a-f0-9]{32}$/)",
        ".indexOn": [
          "start"
        ],
        "$session": {
          ".write": "$key.matches(/^[a-f0-9]{32}$/) && $session.matches(/^[a-f0-9]{32}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['start', 'last', 'seconds', 'games', 'wins', 'active']) && (!data.exists() || newData.child('start').val() === data.child('start').val()) && (!data.exists() || newData.child('app').val() === data.child('app').val()) && (newData.child('app').val() !== 'sudoku' || newData.hasChildren(['level', 'daily', 'hints', 'mistakes']))",
          "start": {
            ".validate": "newData.isNumber() && newData.val() >= 1577836800000 && newData.val() <= now + 300000 && newData.val() % 1 === 0"
          },
          "last": {
            ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('start').val() && newData.val() <= now + 300000 && newData.val() <= newData.parent().child('start').val() + 90000000 && newData.val() % 1 === 0"
          },
          "seconds": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90000 && newData.val() % 1 === 0"
          },
          "games": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
          },
          "wins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "app": {
            ".validate": "newData.isString() && newData.val() === 'sudoku'"
          },
          "level": {
            ".validate": "newData.parent().child('app').val() === 'sudoku' && newData.isString() && (newData.val() === 'easy' || newData.val() === 'medium' || newData.val() === 'hard' || newData.val() === 'expert' || newData.val() === 'master' || newData.val() === 'extreme')"
          },
          "daily": {
            ".validate": "newData.parent().child('app').val() === 'sudoku' && newData.isBoolean()"
          },
          "hints": {
            ".validate": "newData.parent().child('app').val() === 'sudoku' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000"
          },
          "mistakes": {
            ".validate": "newData.parent().child('app').val() === 'sudoku' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000"
          },
          "detail": {
            ".validate": "newData.hasChildren(['v', 'round', 'reason', 'progress', 'initial', 'total', 'lastAction', 'actionAt', 'lastProgressAt', 'maxGap']) && (!data.exists() || newData.child('round').val() === data.child('round').val()) && (newData.child('reason').val() === 'playing' || newData.hasChild('ended'))",
            "v": {
              ".validate": "newData.val() === 1"
            },
            "round": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
            },
            "reason": {
              ".validate": "newData.isString() && (newData.val() === 'playing' || newData.val() === 'unknown' || newData.val() === 'won' || newData.val() === 'lost' || newData.val() === 'stuck' || newData.val() === 'new_game' || newData.val() === 'restart' || newData.val() === 'menu' || newData.val() === 'pause' || newData.val() === 'hidden' || newData.val() === 'closed' || newData.val() === 'idle' || newData.val() === 'suspended' || newData.val() === 'midnight' || newData.val() === 'recovered')"
            },
            "total": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 81"
            },
            "progress": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 81 && newData.val() <= newData.parent().child('total').val()"
            },
            "initial": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 81 && newData.val() <= newData.parent().child('total').val()"
            },
            "maxGap": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 120"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -100000 && newData.val() <= 1000000"
            },
            "gameSeconds": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9000000"
            },
            "actions": {
              "$other": {
                ".validate": false
              },
              "move": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "draw": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "recycle": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "undo": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "hint": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "blocked": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "auto_finish": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "input": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "mistake": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "note": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "erase": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "second_chance": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000"
              }
            },
            "lastAction": {
              ".validate": "newData.isString() && (newData.val() === 'none' || newData.val() === 'move' || newData.val() === 'draw' || newData.val() === 'recycle' || newData.val() === 'undo' || newData.val() === 'hint' || newData.val() === 'blocked' || newData.val() === 'auto_finish' || newData.val() === 'input' || newData.val() === 'mistake' || newData.val() === 'note' || newData.val() === 'erase' || newData.val() === 'second_chance')"
            },
            "$other": {
              ".validate": false
            },
            "build": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "mode": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "autoCheck": {
              ".validate": "newData.isBoolean()"
            },
            "mistakeLimit": {
              ".validate": "newData.isBoolean()"
            },
            "tapMove": {
              ".validate": "newData.isBoolean()"
            },
            "autoFinish": {
              ".validate": "newData.isBoolean()"
            },
            "actionAt": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && (newData.val() === 0 || (newData.val() >= newData.parent().parent().child('start').val() && newData.val() <= newData.parent().parent().child('last').val()))"
            },
            "lastProgressAt": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= newData.parent().parent().child('start').val() && newData.val() <= newData.parent().parent().child('last').val()"
            },
            "ended": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= newData.parent().parent().child('last').val() && newData.val() <= now + 300000"
            }
          }
        }
      }
    },
    "players": {
      ".read": true,
      "$key": {
        ".write": "$key.matches(/^[a-f0-9]{32}$/) && newData.exists()",
        ".validate": "newData.hasChild('device') || newData.hasChild('name')",
        "device": {
          ".validate": "newData.isString() && (newData.val() === 'iPad' || newData.val() === 'iPhone' || newData.val() === 'Android' || newData.val() === 'Computer')"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
